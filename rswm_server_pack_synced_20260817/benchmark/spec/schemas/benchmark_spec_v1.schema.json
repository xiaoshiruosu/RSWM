{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rswm.benchmark_spec/v1",
  "title": "RSWM-Bench specification sidecar v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "benchmark_version",
    "task_id",
    "conditioning_track",
    "data_domain",
    "capability_partition",
    "manifest_path",
    "manifest",
    "protocol",
    "schema_bundle",
    "evaluator",
    "metric_panel_version",
    "direction_convention_version",
    "overlap_definition_version",
    "sample_visibility_policy",
    "task_parameters",
    "headline_eligible",
    "legacy_compatible",
    "spec_checksum"
  ],
  "properties": {
    "schema": {"const": "rswm.benchmark_spec/v1"},
    "benchmark_version": {"type": "string", "minLength": 1},
    "task_id": {
      "enum": ["T1_spatial_rollout", "T2_arbitrary_direction", "T3_overlap_ladder"]
    },
    "conditioning_track": {"enum": ["A_text", "B_camera", "C_multiview"]},
    "data_domain": {"enum": ["synthetic_controlled", "generalization", "real_world"]},
    "capability_partition": {"enum": ["native", "adapted", "multiview"]},
    "manifest_path": {"type": "string", "minLength": 1},
    "manifest": {"$ref": "#/$defs/componentIdentity"},
    "protocol": {"$ref": "#/$defs/componentIdentity"},
    "schema_bundle": {"$ref": "#/$defs/componentIdentity"},
    "evaluator": {"$ref": "#/$defs/componentIdentity"},
    "metric_panel_version": {"type": "string", "minLength": 1},
    "direction_convention_version": {"type": "string", "minLength": 1},
    "overlap_definition_version": {"type": "string", "minLength": 1},
    "sample_visibility_policy": {"const": "rswm.sample_visibility/track-whitelist-v1"},
    "task_parameters": {"type": "object"},
    "headline_eligible": {"type": "boolean"},
    "legacy_compatible": {"type": "boolean"},
    "spec_checksum": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "componentIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "artifact_id", "schema", "version", "sha256", "status"],
      "properties": {
        "kind": {"type": "string", "minLength": 1},
        "artifact_id": {"type": "string", "minLength": 1},
        "schema": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "status": {"enum": ["declared", "verified", "not_available"]}
      }
    }
  }
}
