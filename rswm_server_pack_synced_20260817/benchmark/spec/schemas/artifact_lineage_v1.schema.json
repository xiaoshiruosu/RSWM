{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rswm.artifact_lineage/v1",
  "title": "RSWM-Bench checkpoint-to-result artifact lineage v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "artifacts", "edges", "lineage_checksum"],
  "properties": {
    "schema": {"const": "rswm.artifact_lineage/v1"},
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/artifact"}
    },
    "edges": {
      "type": "array",
      "items": {"$ref": "#/$defs/edge"}
    },
    "model_identity": {"$ref": "urn:rswm:model-identity:v1"},
    "lineage_checksum": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "artifact_id", "sha256", "schema", "version", "uri", "metadata"],
      "properties": {
        "kind": {
          "enum": ["checkpoint", "adapter", "benchmark_spec", "manifest", "metric", "result"]
        },
        "artifact_id": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "schema": {"type": ["string", "null"]},
        "version": {"type": ["string", "null"]},
        "uri": {"type": ["string", "null"]},
        "metadata": {"type": "object"}
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from_sha256", "to_sha256", "relation"],
      "properties": {
        "from_sha256": {"$ref": "#/$defs/sha256"},
        "to_sha256": {"$ref": "#/$defs/sha256"},
        "relation": {"type": "string", "minLength": 1}
      }
    }
  }
}
