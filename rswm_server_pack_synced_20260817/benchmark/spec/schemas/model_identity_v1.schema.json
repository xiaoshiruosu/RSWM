{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:rswm:model-identity:v1",
  "title": "RSWM-Bench layered model identity v1",
  "description": "Separates checkpoint release branding, architecture, camera conditioning, LoRA adaptation and execution route.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "model_family",
    "release_identity",
    "adapter_identity",
    "checkpoint_identity",
    "architecture_identity",
    "camera_condition_identity",
    "lora_identity",
    "execution_identity",
    "status",
    "identity_checksum"
  ],
  "properties": {
    "schema": {"const": "rswm.model_identity/v1"},
    "model_family": {"type": "string", "minLength": 1},
    "release_identity": {"type": "string", "minLength": 1},
    "adapter_identity": {"type": "string", "minLength": 1},
    "checkpoint_identity": {"$ref": "#/$defs/checkpointIdentity"},
    "architecture_identity": {"$ref": "#/$defs/architectureIdentity"},
    "camera_condition_identity": {"$ref": "#/$defs/cameraConditionIdentity"},
    "lora_identity": {
      "anyOf": [
        {"$ref": "#/$defs/loraIdentity"},
        {"type": "null"}
      ]
    },
    "execution_identity": {"$ref": "#/$defs/executionIdentity"},
    "status": {"enum": ["declared", "verified", "not_available"]},
    "identity_checksum": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nullableSha256": {
      "anyOf": [
        {"$ref": "#/$defs/sha256"},
        {"type": "null"}
      ]
    },
    "nullableNonemptyString": {
      "anyOf": [
        {"type": "string", "minLength": 1},
        {"type": "null"}
      ]
    },
    "uniqueNonemptyStrings": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "checkpointIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "revision",
        "sha256_manifest",
        "config_hash",
        "status"
      ],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "revision": {"$ref": "#/$defs/nullableNonemptyString"},
        "sha256_manifest": {"$ref": "#/$defs/nullableSha256"},
        "config_hash": {"$ref": "#/$defs/nullableSha256"},
        "status": {"enum": ["declared", "verified", "not_available"]}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "verified"}}},
          "then": {
            "properties": {
              "revision": {"type": "string", "minLength": 1},
              "sha256_manifest": {"$ref": "#/$defs/sha256"},
              "config_hash": {"$ref": "#/$defs/sha256"}
            }
          }
        }
      ]
    },
    "architectureIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transformer_type",
        "vae",
        "text_encoder",
        "camera_conditioning_type",
        "implementation_aliases"
      ],
      "properties": {
        "transformer_type": {"type": "string", "minLength": 1},
        "vae": {"type": "string", "minLength": 1},
        "text_encoder": {"type": "string", "minLength": 1},
        "camera_conditioning_type": {"type": "string", "minLength": 1},
        "implementation_aliases": {"$ref": "#/$defs/uniqueNonemptyStrings"}
      }
    },
    "cameraConditionIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["encoding", "pose_injection", "injector_type", "version"],
      "properties": {
        "encoding": {"type": "string", "minLength": 1},
        "pose_injection": {"type": "string", "minLength": 1},
        "injector_type": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "loraIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_modules", "rank", "alpha"],
      "properties": {
        "target_modules": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "rank": {"type": "integer", "minimum": 1},
        "alpha": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "executionIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["route", "entrypoint", "legacy_aliases"],
      "properties": {
        "route": {
          "type": "string",
          "minLength": 1,
          "description": "Examples include wan-inline and a future benchmark-adapter route."
        },
        "entrypoint": {"$ref": "#/$defs/nullableNonemptyString"},
        "legacy_aliases": {
          "allOf": [
            {"$ref": "#/$defs/uniqueNonemptyStrings"}
          ],
          "description": "Preserves historical execution/architecture labels such as wan."
        }
      }
    }
  }
}
