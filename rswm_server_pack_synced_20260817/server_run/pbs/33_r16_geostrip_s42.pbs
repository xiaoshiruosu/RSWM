#!/bin/bash
#PBS -P rx40
#PBS -q gpuhopper
#PBS -N rswm_33_r16_geostrip_s42
#PBS -l ncpus=12,ngpus=1,mem=128GB,jobfs=100GB,walltime=40:00:00
#PBS -l storage=scratch/qk73+scratch/rx40
#PBS -l wd
#PBS -j oe
# =============================================================================
# 归因实验 2(拍板④,2026-07-26):geo_direction_stripped —— 单 seed,AID,主 r16。
#
# 问题:23 号是 text+Plücker(prompt 里已有方向词),测的是几何通道的【边际】
# 贡献;论文却想写 "neither native route carries direction"。要支撑 either-route
# 措辞,必须有一次【几何通道单独】的测量:保留真实轨迹 poses,prompt 删除
# 一切方向词(段数保留)。
#   * 若此配置方向合规显著优于随机 → 几何通道【能】独立携带方向,
#     论文才允许写 either/both route 类措辞(拍板④原话);
#   * 若仍≈随机 → 措辞收窄为"两条原生路由在本 backbone 上均未传递方向",
#     并明确这是在各自单独/边际条件下的测量。
#
# Track A 方向目标:prompt 无方向词 → evaluate v2.5 从 waypoints 端点量化
# 推导(与建库量化 0-359° 全扫逐位一致);日志会打"方向目标来源: waypoints=N"。
# 依赖:afterok:01。派生 H5 在本作业内生成(dst 已存在即硬错)。
# =============================================================================
_ENVF="${PBS_O_WORKDIR:-$PWD}/server_run/pbs/_pbs_env.sh"
[ -f "$_ENVF" ] || { echo "FATAL: 找不到 $_ENVF"; exit 1; }
source "$_ENVF"
# [v2.10] 评估条数分层:消融/诊断臂用 $N_EVAL_ABLATION(headline 的前缀子集)。
# 旧版一律 0(=全部 val=100),FVD 的常规做法是 2048+,FID 在 N=100 上基本是噪声。
# [v2.9.3] 产物角色 —— 进 run_manifest,并参与 headline 资格判定
export RSWM_RUN_ROLE=variant_attribution
# [v2.8.1 P0-2] pose_mode 必须显式声明 —— v2.8 起 train.py 有 pose_mode↔H5
# 一致性硬门,漏设会用 common.sh 的默认 native 去配 identity_neutralized 的
# SEM_H5,作业启动即失败。语义臂走 SEM_ARM_MODE 开关(见 _pbs_env.sh)。
export POSE_MODE=native
# [v2.8.1 P0-2] pose_mode 必须显式 —— 见 _pbs_env.sh 的 SEM_ARM_MODE 注释

STRIP_H5="$DATA_DIR/train_geostrip.h5"
GEO_SHA=$(h5_sha "$GEO_H5")

if ! sha_stamp_ok "$STAMPS/p33_variant.sha256" "$GEO_SHA"; then
    rm -f "$STRIP_H5"
    $PY "$ROOT/server_run/make_variant_h5.py" --mode direction_stripped \
        --src "$GEO_H5" --dst "$STRIP_H5" \
        2>&1 | tee "$LOGS/p33_variant.log"
    [ -f "$STRIP_H5" ] || { echo "FATAL: 派生 $STRIP_H5 失败" >&2; exit 1; }
    sha_stamp "$STAMPS/p33_variant.sha256" "$GEO_SHA"
fi

export SEED=42 SPLIT_SEED=42 LORA_TARGETS=all
OUT="$WORK/train_r16_geostrip_s42"
if ! done_p p_tr_r16_geostrip_s42; then
    train_lora r16_geostrip_s42 16 16 "$STRIP_H5" "$OUT"; stamp p_tr_r16_geostrip_s42
fi
if ! done_p p_ev_r16_geostrip_s42; then
    eval_lora r16_geostrip_s42 "$OUT/best_checkpoint" "$STRIP_H5" \
        "$OUT/train_val_split.json" "$WORK/eval_r16_geostrip_s42" "$N_EVAL_ABLATION"
    stamp p_ev_r16_geostrip_s42
fi
if done_p p_tr_r16_geostrip_s42 && done_p p_ev_r16_geostrip_s42; then
    find "$OUT" -maxdepth 1 -type d -name 'checkpoint-epoch-*' -exec rm -rf {} + 2>/dev/null || true
    echo "[cleanup] 已清理 $OUT/checkpoint-epoch-*(保留 best_checkpoint)"
fi
echo "[ok] r16_geostrip_s42 train+eval 完成(几何通道单独测量)"
