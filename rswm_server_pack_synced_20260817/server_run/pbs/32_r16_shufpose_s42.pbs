#!/bin/bash
#PBS -P rx40
#PBS -q gpuhopper
#PBS -N rswm_32_r16_shufpose_s42
#PBS -l ncpus=12,ngpus=1,mem=128GB,jobfs=100GB,walltime=40:00:00
#PBS -l storage=scratch/qk73+scratch/rx40
#PBS -l wd
#PBS -j oe
# =============================================================================
# 归因实验 1(拍板④,2026-07-26):shuffled_pose —— 单 seed,AID,主 r16。
#
# 问题:23 号(text+Plücker)相对 20 号(text-only)六项全弱,论文写成"激活
# 几何通道费保真"。但这混淆了两件事:(a) 编码【这条真实轨迹】的信息代价,
# (b) 任何非 identity / 分布外 pose 信号对预训练 pose 通路的通用扰动。
# 本作业把 poses 在样本间确定性错位配对(图像/prompt/目标序列全不变),
# 若同样费 ~8 点 FVD → "几何费保真"实为通路脆弱,而非编码轨迹的代价;
# 若明显不费 → 代价确实来自"编码真实轨迹"这件事本身。
#
# 依赖:afterok:01(需 $GEO_H5 与三道门 PASS)。派生 H5 在本作业内生成
# (不覆盖既有文件;dst 已存在即硬错)。评估口径与 20/23 完全一致。
# =============================================================================
_ENVF="${PBS_O_WORKDIR:-$PWD}/server_run/pbs/_pbs_env.sh"
[ -f "$_ENVF" ] || { echo "FATAL: 找不到 $_ENVF"; exit 1; }
source "$_ENVF"
# [v2.10] 评估条数分层:消融/诊断臂用 $N_EVAL_ABLATION(headline 的前缀子集)。
# 旧版一律 0(=全部 val=100),FVD 的常规做法是 2048+,FID 在 N=100 上基本是噪声。
# [v2.9.3] 产物角色 —— 进 run_manifest,并参与 headline 资格判定
export RSWM_RUN_ROLE=variant_attribution
# [v2.8.1 P0-2] pose_mode 必须显式声明 —— v2.8 起 train.py 有 pose_mode↔H5
# 一致性硬门,漏设会用 common.sh 的默认 native 去配 identity_neutralized 的
# SEM_H5,作业启动即失败。语义臂走 SEM_ARM_MODE 开关(见 _pbs_env.sh)。
export POSE_MODE=native
# [v2.8.1 P0-2] pose_mode 必须显式 —— 见 _pbs_env.sh 的 SEM_ARM_MODE 注释

SHUF_H5="$DATA_DIR/train_shufpose.h5"
GEO_SHA=$(h5_sha "$GEO_H5")

# ---- 派生数据集(sha 绑定:GEO_H5 内容一变必重派生) ----
if ! sha_stamp_ok "$STAMPS/p32_variant.sha256" "$GEO_SHA"; then
    rm -f "$SHUF_H5"          # 重派生前清旧件(仅本 variant 文件)
    $PY "$ROOT/server_run/make_variant_h5.py" --mode shuffled_pose \
        --src "$GEO_H5" --dst "$SHUF_H5" --seed 42 \
        2>&1 | tee "$LOGS/p32_variant.log"
    [ -f "$SHUF_H5" ] || { echo "FATAL: 派生 $SHUF_H5 失败" >&2; exit 1; }
    sha_stamp "$STAMPS/p32_variant.sha256" "$GEO_SHA"
fi

export SEED=42 SPLIT_SEED=42 LORA_TARGETS=all
OUT="$WORK/train_r16_shufpose_s42"
if ! done_p p_tr_r16_shufpose_s42; then
    train_lora r16_shufpose_s42 16 16 "$SHUF_H5" "$OUT"; stamp p_tr_r16_shufpose_s42
fi
if ! done_p p_ev_r16_shufpose_s42; then
    eval_lora r16_shufpose_s42 "$OUT/best_checkpoint" "$SHUF_H5" \
        "$OUT/train_val_split.json" "$WORK/eval_r16_shufpose_s42" "$N_EVAL_ABLATION"
    stamp p_ev_r16_shufpose_s42
fi
if done_p p_tr_r16_shufpose_s42 && done_p p_ev_r16_shufpose_s42; then
    find "$OUT" -maxdepth 1 -type d -name 'checkpoint-epoch-*' -exec rm -rf {} + 2>/dev/null || true
    echo "[cleanup] 已清理 $OUT/checkpoint-epoch-*(保留 best_checkpoint)"
fi
echo "[ok] r16_shufpose_s42 train+eval 完成(对照 23 号 r16_geo_s42)"
