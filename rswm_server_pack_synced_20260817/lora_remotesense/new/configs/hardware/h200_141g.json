{
  "schema_version": 1,
  "profile": "h200_141g",
  "gpu_family": "NVIDIA H200 141GB",
  "compute_capability": "9.0",
  "precision": "bf16",
  "micro_batch_size": 1,
  "gradient_accumulation_steps": 4,
  "gradient_checkpointing": true,
  "attention_backend": "auto",
  "attention_preference": ["flash_attn_3", "flash_attn_2", "sdpa"],
  "num_workers": 2,
  "prefetch_factor": 2,
  "persistent_workers": false,
  "pin_memory": true,
  "t5_cpu": true,
  "vae_cpu": true,
  "vae_strategy": "cpu_swap_serial",
  "offload": "auto",
  "inactive_model_cpu": false,
  "optimizer": "bitsandbytes.AdamW8bit",
  "torch_compile": false,
  "fp8": false,
  "notes": "Preserves the existing Hopper resident-expert path; no FP8 requirement."
}
